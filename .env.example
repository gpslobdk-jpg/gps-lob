STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
FAMILY_SSO_ENABLED=
DAGENSTAVLE_SSO_ORIGIN=
FAMILY_SSO_EXCHANGE_SECRET=
PRINTMITARBEJDSARK_ENABLED=
PRINTMITARBEJDSARK_SSO_ORIGIN=
PRINTMITARBEJDSARK_SSO_EXCHANGE_SECRET=
# Default-off rollout flag for teacher-to-teacher execution sharing.
NEXT_PUBLIC_RUN_EXECUTION_SHARING_ENABLED=false
# Pilen realtime is default-off. Enable client and server separately per Vercel
# environment; keep both false in Production until every release gate below is met.
NEXT_PUBLIC_PILEN_REALTIME_ENABLED=false
PILEN_REALTIME_ENABLED=false
# Server-only OpenAI credential. Never use a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
# Separate high-entropy secret for rate-limit fingerprints and short-lived stop tokens.
PILEN_REALTIME_RATE_LIMIT_SECRET=
# Server-only model choice. Preview defaults to gpt-realtime-2.1-mini when unset;
# Production must set one allowlisted model explicitly after the quality review.
PILEN_REALTIME_MODEL=gpt-realtime-2.1-mini
# Realtime is fail-closed unless the approved EU project and ZDR are confirmed.
PILEN_REALTIME_OPENAI_REGION=eu
PILEN_REALTIME_ZDR_CONFIRMED=false
# Set only after the documented child-safety, privacy and school review is complete.
PILEN_REALTIME_UNDER_18_REVIEW_CONFIRMED=false
# Production-only final release approval. It is ignored outside Production.
PILEN_REALTIME_PRODUCTION_APPROVED=false
# Sentry auth token for production source map and release upload.
# Set this in Vercel/CI only. Never expose it in client-side env vars.
SENTRY_AUTH_TOKEN=
# Optional explicit Sentry release identifier.
# In Vercel this can map to the current git SHA for clearer release tracking.
SENTRY_RELEASE=
# Discord webhook URL for production alerts (GPS fallback, frosset svar-knap)
# Opret via: Discord kanal → Indstillinger → Integrationer → Webhooks
DISCORD_WEBHOOK_URL=
